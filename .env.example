# TrialMatch AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Anthropic ──────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── App ────────────────────────────────────────────────────────────────────
# Host/port for the FastAPI backend (default: 0.0.0.0:8900)
APP_HOST=0.0.0.0
APP_PORT=8900

# Environment: development | staging | production
ENVIRONMENT=development

# ─── ClinicalTrials.gov API ─────────────────────────────────────────────────
# Base URL for CT.gov API v2 (no key required — public API)
CTGOV_API_BASE=https://clinicaltrials.gov/api/v2

# ─── AWS (optional — for S3 temporary PDF storage) ──────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
